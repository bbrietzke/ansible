service {
    name    = "pgsql"
    id      = "pgsql-{{ ansible_hostname | lower }}"
    port    = {{ postgres_port }}
    tags    = ["pgsql", "static", "ansible"]

    meta    = {
        managed_by      =   "ansible"
        version         =   "{{ postgres_version | default('unknown') }}"
    }

    check {
        name        = "pg_isready"
        interval    = "30s"
        timeout     = "2s"
        args        = ["pg_isready", "-h", "localhost"]
    }
}